# =======================================================
# Zyllo Tech Server Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# Never commit real secrets to version control.
# =======================================================

PORT=3000
JWT_SECRET=your_jwt_secret_key_change_in_production

# Public Base URL (Used for generating email tracker links and webhooks)
PUBLIC_BASE_URL=http://localhost:3000

# Live SMTP Configuration (e.g. Gmail, AWS SES, SendGrid, Zoho)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=Zyllo Tech <your-email@gmail.com>
ADMIN_ALERT_EMAIL=admin@zyllotech.com

# Optional: External AI Provider Keys (If omitted, system uses built-in verified knowledge engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
